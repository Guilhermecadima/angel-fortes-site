{
  "rewrites": [
    {
      "source": "/loja",
      "destination": "/index.html"
    },
    {
      "source": "/loja/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ],
    "crons": [
    {
      "path": "/api/cron/followup",
      "schedule": "0 10 * * *"
    }
  ]
}
